# Generated by editorconfig.build | version: 7585df3ff8e93358
# Editor configuration, see https://editorconfig.org
# dotnet specific options: https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/code-style-rule-options
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{xml,json,slnx,csproj,props,targets,yml,yaml}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.cs]
# Defining styles
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.under_camel_case.required_prefix = _
dotnet_naming_style.under_camel_case.capitalization = camel_case

# Constants should be PascalCase
dotnet_naming_rule.const_pascal_case.symbols = all_consts
dotnet_naming_rule.const_pascal_case.style = pascal_case
dotnet_naming_rule.const_pascal_case.severity = suggestion
dotnet_naming_symbols.all_consts.required_modifiers = const
dotnet_naming_symbols.all_consts.applicable_kinds = field

# Static fields should be PascalCase
dotnet_naming_rule.static_fields.symbols = static_fields
dotnet_naming_rule.static_fields.style = pascal_case
dotnet_naming_rule.static_fields.severity = suggestion
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static

# Private fields naming style
dotnet_naming_rule.fields_under_camel_case.symbols = all_fields
dotnet_naming_rule.fields_under_camel_case.style = under_camel_case
dotnet_naming_rule.fields_under_camel_case.severity = suggestion
dotnet_naming_symbols.all_fields.applicable_kinds = field
dotnet_naming_symbols.all_fields.applicable_accessibilities = private

# Resharper "fixes"
csharp_wrap_before_ternary_opsigns = true : suggestion
# Stop doing the cursed style of argument wrapping
csharp_wrap_arguments_style = wrap_if_long : warning
# Resharper ignores other rules to keep existing line break arrangements, so setting the line length to 180
resharper_csharp_max_line_length = 180

# Basic rules
dotnet_style_prefer_auto_properties = true
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Dotnet / C# rules
dotnet_code_quality_unused_parameters                       = non_public : suggestion
dotnet_style_operator_placement_when_wrapping = end_of_line : warning
dotnet_style_predefined_type_for_locals_parameters_members  = true : warning
dotnet_style_predefined_type_for_member_access              = true : warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = when_multiline : warning
csharp_prefer_simple_using_statement = true : suggestion
csharp_space_after_keywords_in_control_flow_statements      = true : warning
csharp_style_expression_bodied_accessors = when_on_single_line : suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line : suggestion
csharp_style_expression_bodied_methods = when_on_single_line : suggestion
csharp_style_expression_bodied_properties = when_on_single_line : suggestion
csharp_style_namespace_declarations = file_scoped : warning
csharp_style_throw_expression                               = true : suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true : suggestion
csharp_style_prefer_switch_expression = true : suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true : suggestion
csharp_style_prefer_not_pattern = true : suggestion
