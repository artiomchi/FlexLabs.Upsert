<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <NoWarn>EF1001</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="Microsoft.EntityFrameworkCore" />
    <Using Include="Xunit" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Disabling Oracle tests until Oracle.EntityFrameworkCore supports EF Core 11 -->
    <DisableOracle>true</DisableOracle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(POSTGRES_ONLY)'!=''">
    <DisableMsSql>true</DisableMsSql>
    <DisableMySql>true</DisableMySql>
    <DisableOracle>true</DisableOracle>
  </PropertyGroup>

  <!-- A disabled engine drops its provider package and defines NOxxx; see Base/DisabledProviderExtensions.cs -->
  <PropertyGroup Condition="'$(DisableMsSql)'=='true'">
    <DefineConstants>$(DefineConstants);NOMSSQL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisableMySql)'=='true'">
    <DefineConstants>$(DefineConstants);NOMYSQL</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisableOracle)'=='true'">
    <DefineConstants>$(DefineConstants);NOORACLE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DisablePostgres)'=='true'">
    <DefineConstants>$(DefineConstants);NOPOSTGRES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" PrivateAssets="all" />
    <PackageReference Include="Testcontainers.XunitV3" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsSql)'!='true'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMySql)'!='true'">
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" />
    <PackageReference Include="Testcontainers.MySql" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableOracle)'!='true'">
    <PackageReference Include="Oracle.EntityFrameworkCore" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Testcontainers.Oracle" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisablePostgres)'!='true'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlexLabs.EntityFrameworkCore.Upsert\FlexLabs.EntityFrameworkCore.Upsert.csproj" />
  </ItemGroup>

</Project>
